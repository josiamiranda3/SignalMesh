# ============================================================================
# SIGNALMESH — Research & Evidence Intelligence
# Copy this file to `.env` and fill in what you need. NEVER commit `.env`.
# ============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=8787
# Origin the app is served from. Used for cookie security and the CSRF check.
APP_ORIGIN=http://127.0.0.1:8787
# SQLite file used by the local runtime. Use :memory: for a throwaway instance.
DATABASE_URL=.data/signalmess.sqlite
# REQUIRED in production: 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=1209600

# --- Global cost switches (both default to OFF) ------------------------------
# Master switch for ANY external provider call (Exa + Gemini).
ENABLE_EXTERNAL_APIS=false
# Must be true as well for operations that can bill money. Leave false to stay
# strictly inside documented free tiers.
ENABLE_PAID_OPERATIONS=false

# --- Exa (research) ----------------------------------------------------------
# Own Exa API key. Read only by the backend; never exposed to the browser.
EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai
# auto | lite | deep-lite | deep
EXA_SEARCH_TYPE=auto
EXA_TIMEOUT_MS=20000

# --- Google Gemini (analysis) ------------------------------------------------
# Own Gemini API key. Read only by the backend; never exposed to the browser.
GEMINI_API_KEY=
# Verified against the current Gemini API. Check availability/free tier for
# your key before switching models.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=45000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.2

# --- Cost protection ---------------------------------------------------------
# SignalMesh limits, not provider limits. Adjust deliberately.
RESEARCH_DAILY_LIMIT=3
ANALYSIS_DAILY_LIMIT=3
RESEARCH_GLOBAL_DAILY_LIMIT=30
ANALYSIS_GLOBAL_DAILY_LIMIT=30
# Minimum seconds between two identical research queries (duplicate guard).
DUPLICATE_GUARD_SECONDS=90
# Requests per minute per session across the API.
API_RATE_LIMIT_PER_MINUTE=120

# --- Optional ----------------------------------------------------------------
# Create the clearly-labelled demo investigation on boot (local evaluation only).
SEED_DEMO_DATA=false
