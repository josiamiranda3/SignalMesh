{
  "name": "signalmess",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "SIGNALMESH — Research & Evidence Intelligence Platform",
  "engines": {
    "node": ">=22.15.0 <23 || >=24 <25 || >=26 <27",
    "npm": ">=11.6.0"
  },
  "scripts": {
    "dev": "node --experimental-transform-types --disable-warning=ExperimentalWarning server/dev.ts",
    "dev:web": "vite",
    "dev:deepspace": "deepspace dev start",
    "build": "vite build",
    "preview": "node --experimental-transform-types --disable-warning=ExperimentalWarning server/dev.ts --serve-dist",
    "deploy": "deepspace deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "check:encoding": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/check-encoding.ts",
    "test": "node --test --test-isolation=none --experimental-transform-types --disable-warning=ExperimentalWarning \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\" \"tests/worker/*.test.ts\"",
    "test:unit": "node --test --test-isolation=none --experimental-transform-types --disable-warning=ExperimentalWarning \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-isolation=none --experimental-transform-types --disable-warning=ExperimentalWarning \"tests/integration/**/*.test.ts\"",
    "test:contract": "node --test --test-isolation=none --experimental-transform-types --disable-warning=ExperimentalWarning \"tests/worker/*.test.ts\"",
    "test:e2e": "node --experimental-transform-types --disable-warning=ExperimentalWarning tests/e2e/run-e2e.ts",
    "test:flows": "node --experimental-transform-types --disable-warning=ExperimentalWarning tests/e2e/run-flows.ts",
    "test:worker": "node --experimental-transform-types --disable-warning=ExperimentalWarning tests/worker/run-worker-smoke.ts",
    "audit:design": "node --experimental-transform-types --disable-warning=ExperimentalWarning tests/e2e/design-audit.ts",
    "migrate:records": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/migrate-to-records.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:encoding && npm run build && npm run test",
    "verify:all": "npm run verify && npm run test:e2e && npm run test:flows && npm run audit:design && npm run test:worker"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hono/node-server": "2.1.9",
    "clsx": "2.1.1",
    "deepspace": "0.44.2",
    "hono": "4.13.19",
    "lucide-react": "0.460.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.0",
    "@cloudflare/workers-types": "^4.20260329.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "8.3.8",
    "wrangler": "^4.79.0"
  }
}
